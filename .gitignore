# ============================================================
# Habbo Project - .gitignore
# ============================================================

# ----- Installers & Commercial Software -----
# JDK installer (~205 MB), Navicat portable (~160 MB)
# These exceed GitHub's 100 MB file limit and can be re-downloaded
1- Install/

# ----- Dependencies (reinstallable via package managers) -----
**/node_modules/
**/vendor/

# ----- XAMPP Runtime & Database Binaries -----
# Exclude the XAMPP runtime programs entirely
xampp/*
# EXCEPT htdocs which contains our custom code
!xampp/htdocs/

# ----- Heavy Binary Assets (SWF / Nitro) -----
# We exclude these so the repo stays light and pushable. 
# They contain 300,000+ files and we only care about code.
xampp/htdocs/public/nitro-assets/
xampp/htdocs/public/swf/
xampp/htdocs/swf/
xampp/htdocs/nitro-assets/

# ----- Build artifacts -----
**/dist/
**/build/

# ----- OS files -----
Thumbs.db
Desktop.ini
.DS_Store

# ----- IDE files -----
.idea/
*.suo
*.user
*.sln.docstates

# ----- Misc -----
*.log
*.cache
Emulator/logging/debug.txt
Emulator/CreditBridge/classes/
avatar-sync-mvp/src/main/java/com/neah/avatarsync/*.bak*
avatar-sync-mvp/src/main/java/com/neah/avatarsync/*.STABLE-*
**/target/
*.class
*.bak-*
*.backup-*
*.roto-*

# ----- Local secrets -----
**/.env
**/.env.*
!**/.env.example

# ----- Runtime logs & compressed logs -----
Emulator/logging/
*.gz

# ----- Local backups / snapshots -----
backup-pre-*.sql
backups/
**/_backups/
**/_holo_backup*/
*.bak
*.bak.*
*.broken-*

# ----- Laravel runtime/storage -----
xampp/htdocs/storage/

# ----- Local test artifacts -----
xampp/htdocs/prueba-apache.txt
xampp/htdocs/public/prueba-apache.txt
xampp/htdocs/nitro-react/cls
xampp/htdocs/nitro-react/powershell
# ----- Additional local backups / inspection output -----
BACKUP-CONFIG-*.txt
**/_holo*_backup*/
avatar-sync-mvp.zip
Emulator/plugin-inspect/
Emulator/plugin-manifest-inspect/
# ----- Reproducible local environments -----
tools/rembg-venv/

# ----- Historical local snapshots -----
Archivo/
xampp/htdocs/public/dist - copia/

# ----- Database dumps -----
PackAIO-V4.sql
# ----- Generated audits -----
Auditoria/
